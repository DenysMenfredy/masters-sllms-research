# Optional convenience settings. Copy to .env and source explicitly in your shell.
# Commands do not silently load .env. Never commit credentials.
HF_HOME=./.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
TOKENIZERS_PARALLELISM=false
UV_CACHE_DIR=./.cache/uv
# Set these after installing Android platform-tools and an exact NDK version.
# ANDROID_NDK_HOME=/absolute/path/to/android-ndk
# ANDROID_SERIAL=device-serial
# LLAMA_CPP_DIR=/absolute/path/to/pinned/llama.cpp
# LLAMA_CPP_COMMIT=full-40-character-commit
